# ═══════════════════════════════════════════════════════════
# Travel Shop Algeria — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to backend/.env and web/.env with appropriate values

# ─── Application ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tsa_user
DB_PASSWORD=tsa_password
DB_DATABASE=travel_shop_algeria

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Elasticsearch ────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRATION=7d

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── SendGrid ─────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@travelshopalgeria.com

# ─── Encryption ───────────────────────────────────────────
ENCRYPTION_KEY=your_32_char_encryption_key_here

# ─── Exchange Rates ───────────────────────────────────────
EXCHANGE_RATES_API_KEY=your_exchange_rates_api_key

# ─── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
NEXT_PUBLIC_DEFAULT_CURRENCY=DZD
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
